# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Generated TB_MOTNJE-shaped CSV output from the Notranjski legacy import
# (tools/legacy_to_tb_motnje_csv.py). Regenerated on demand from the bundled
# legacy JSON; large enough not to belong in git history.
/tools/legacy_csv_out/
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing — never commit. The actual keystore lives outside the repo
# (see /project/DEPLOYMENT.md). key.properties holds plain-text passwords
# that point at it.
/android/key.properties
*.jks
*.keystore

# Local-only credentials sidecars referenced from /project docs (e.g. the
# Google Play App-access demo password). Email goes in the public doc;
# password goes here so it stays out of git history.
/project/.credentials.local.md

# Claude Code per-machine state. .claude/settings.json (shared, no .local)
# can be committed if/when a team-wide permission allowlist is desired;
# the .local variant and worktrees scratch dir stay off the wire.
.claude/settings.local.json
.claude/worktrees/
