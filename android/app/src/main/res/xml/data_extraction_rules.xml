<?xml version="1.0" encoding="utf-8"?>
<!-- TB-61: nothing of this app leaves the phone through Android backup.
     The records, walks and photos (app_flutter, under the root domain) carry exact
     locations and observer names; logout deletes them on the phone (TB-45, TB-49),
     and a backup would keep them in the person's Google account.
     allowBackup="false" in AndroidManifest.xml stops the cloud backup, but on
     Android 12+ some makers' phones still run device-to-device transfer, which
     only these rules govern. So both sections exclude every domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
