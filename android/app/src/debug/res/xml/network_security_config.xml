<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (src/debug): lets a debug build reach a scratch backend
     on the developer's machine over plain HTTP — the emulator sees the host as
     10.0.2.2 (TB-46: the BELEZNICA_API dart-define, http://10.0.2.2:3101/…).
     Release builds never merge this file and stay HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
