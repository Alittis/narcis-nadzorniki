{
  "deployment_type": "manual build",
  "process_manager": "",
  "reverse_proxy": "",
  "containerized": false,
  "primary_port": "",
  "requires_build_step": true,
  "external_services": [
    {
      "name": "ORDS / Oracle APEX",
      "base_url": "https://storitve.igea.si/narcis/ords/narcis/",
      "endpoints": [
        {
          "path": "test/auth",
          "method": "GET",
          "auth": "none (test stub)",
          "status": "test-only"
        },
        {
          "path": "app-auth/login",
          "method": "GET",
          "host": "narcis.gov.si",
          "auth": "X-Narcis-Auth: Basic <base64(email:password)>",
          "status": "deployed; A56 real-device validation passed 2026-04-25; debug instrumentation remains (credentials redacted) for broader-device coverage"
        }
      ]
    },
    {
      "name": "OpenStreetMap tile server",
      "base_url": "https://tile.openstreetmap.org/",
      "purpose": "OSM basemap tiles (BasemapMode.osm)",
      "auth": "none",
      "commercial_terms_confirmed": false
    },
    {
      "name": "Esri ArcGIS Online",
      "base_url": "https://services.arcgisonline.com/ArcGIS/rest/services/",
      "purpose": "Satellite imagery + labels overlay (BasemapMode.satellite)",
      "layers": [
        "World_Imagery/MapServer",
        "Reference/World_Boundaries_and_Places/MapServer"
      ],
      "auth": "none",
      "commercial_terms_confirmed": false
    },
    {
      "name": "Notranjski park WordPress uploads",
      "base_url": "https://nadzor.notranjski-park.si/wp-content/uploads/formidable/",
      "purpose": "Source for photo URLs referenced by bundled legacy records (read-only)",
      "auth": "none",
      "note": "Photos are displayed in the LegacyDetailScreen; the URLs are baked into assets/legacy/notranjski_park_2025.json"
    }
  ],
  "bundled_assets": [
    {
      "path": "assets/legacy/notranjski_park_2025.json",
      "purpose": "Read-only historical disturbance records (703 entries, Mar-Aug 2025) from Notranjski regijski park Formidable form",
      "size_kb": 409,
      "regenerated_by": "tools/import_notranjski_csv.py"
    }
  ],
  "env_required": [],
  "ci_detected": false,
  "auth": {
    "status": "production",
    "endpoint": "https://narcis.gov.si/ords/narcis/app-auth/login",
    "wire_format": "X-Narcis-Auth: Basic <base64(email:password)>",
    "password_enforced": true,
    "server_gate": "TERENSKA-BELEZNICA function via pkg_narcis_authorization",
    "session_persistence": "in-memory (not persisted across app restarts)",
    "offline_cache": {
      "storage": "flutter_secure_storage",
      "hash": "PBKDF2-HMAC-SHA256, 100000 iters, 32-byte salt, 32-byte key",
      "algo_version_tag": "pbkdf2_sha256_100k_v1",
      "max_offline_window_days": 14,
      "wiped_on": ["explicit logout", "online HTTP 401"]
    }
  }
}
